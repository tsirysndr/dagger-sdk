instance objectTypeTypeDef :: IsObject TypeDefTag where
  objectTypeName _ = "TypeDef"

-- | Distinguishes the different kinds of TypeDefs.
data TypeDefKind = TypeDefKindStringKind | TypeDefKindIntegerKind | TypeDefKindFloatKind | TypeDefKindBooleanKind | TypeDefKindScalarKind | TypeDefKindListKind | TypeDefKindObjectKind | TypeDefKindInterfaceKind | TypeDefKindInputKind | TypeDefKindVoidKind | TypeDefKindEnumKind | TypeDefKindString | TypeDefKindInteger | TypeDefKindFloat | TypeDefKindBoolean | TypeDefKindScalar | TypeDefKindList | TypeDefKindObject | TypeDefKindInterface | TypeDefKindInput | TypeDefKindVoid | TypeDefKindEnum
derive instance eqTypeDefKind :: Eq TypeDefKind
derive instance ordTypeDefKind :: Ord TypeDefKind
instance showTypeDefKind :: Show TypeDefKind where
  show = case _ of
    TypeDefKindStringKind -> "STRING_KIND"
    TypeDefKindIntegerKind -> "INTEGER_KIND"
    TypeDefKindFloatKind -> "FLOAT_KIND"
    TypeDefKindBooleanKind -> "BOOLEAN_KIND"
    TypeDefKindScalarKind -> "SCALAR_KIND"
    TypeDefKindListKind -> "LIST_KIND"
    TypeDefKindObjectKind -> "OBJECT_KIND"
    TypeDefKindInterfaceKind -> "INTERFACE_KIND"
    TypeDefKindInputKind -> "INPUT_KIND"
    TypeDefKindVoidKind -> "VOID_KIND"
    TypeDefKindEnumKind -> "ENUM_KIND"
    TypeDefKindString -> "STRING"
    TypeDefKindInteger -> "INTEGER"
    TypeDefKindFloat -> "FLOAT"
    TypeDefKindBoolean -> "BOOLEAN"
    TypeDefKindScalar -> "SCALAR"
    TypeDefKindList -> "LIST"
    TypeDefKindObject -> "OBJECT"
    TypeDefKindInterface -> "INTERFACE"
    TypeDefKindInput -> "INPUT"
    TypeDefKindVoid -> "VOID"
    TypeDefKindEnum -> "ENUM"
instance encodeTypeDefKind :: EncodeJson TypeDefKind where
  encodeJson = encodeJson <<< show
instance decodeTypeDefKind :: DecodeJson TypeDefKind where
  decodeJson value = do
    name <- decodeJson value
    case name of
      "STRING_KIND" -> Right TypeDefKindStringKind
      "INTEGER_KIND" -> Right TypeDefKindIntegerKind
      "FLOAT_KIND" -> Right TypeDefKindFloatKind
      "BOOLEAN_KIND" -> Right TypeDefKindBooleanKind
      "SCALAR_KIND" -> Right TypeDefKindScalarKind
      "LIST_KIND" -> Right TypeDefKindListKind
      "OBJECT_KIND" -> Right TypeDefKindObjectKind
      "INTERFACE_KIND" -> Right TypeDefKindInterfaceKind
      "INPUT_KIND" -> Right TypeDefKindInputKind
      "VOID_KIND" -> Right TypeDefKindVoidKind
      "ENUM_KIND" -> Right TypeDefKindEnumKind
      "STRING" -> Right TypeDefKindString
      "INTEGER" -> Right TypeDefKindInteger
      "FLOAT" -> Right TypeDefKindFloat
      "BOOLEAN" -> Right TypeDefKindBoolean
      "SCALAR" -> Right TypeDefKindScalar
      "LIST" -> Right TypeDefKindList
      "OBJECT" -> Right TypeDefKindObject
      "INTERFACE" -> Right TypeDefKindInterface
      "INPUT" -> Right TypeDefKindInput
      "VOID" -> Right TypeDefKindVoid
      "ENUM" -> Right TypeDefKindEnum
      _ -> Left (TypeMismatch "TypeDefKind")

instance moduleValueTypeDefKind :: V.DaggerValue TypeDefKind where
  valueType _ = V.EnumType "TypeDefKind"
  decodeValue _ = V.decodeJSON
  encodeValue = pure <<< encodeJson

-- | The absence of a value.
-- | 
-- | A Null Void is used as a placeholder for resolvers that do not return anything.
newtype Void = Void Json
derive instance eqVoid :: Eq Void
derive newtype instance encodeVoid :: EncodeJson Void
derive newtype instance decodeVoid :: DecodeJson Void

instance moduleValueVoid :: V.DaggerValue Void where
  valueType _ = V.ScalarType "Void"
  decodeValue _ = V.decodeJSON
  encodeValue = pure <<< encodeJson

-- | A Dagger workspace detected from the current working directory.
foreign import data WorkspaceTag :: Type
type Workspace = Object WorkspaceTag
instance objectTypeWorkspace :: IsObject WorkspaceTag where
  objectTypeName _ = "Workspace"
